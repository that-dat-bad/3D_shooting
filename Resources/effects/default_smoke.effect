# ========================================================
# Effect Configuration File (.effect)
# Default Smoke Effect (低上限・滞留黒煙ベース)
# ========================================================

[General]
name = default_smoke
stopCondition = Manual          # Manual / ByDuration / ByCount
emitInterval = 0.12             # 発生間隔 (秒)
maxDuration = 5.0               # 時間指定停止時の最大継続時間 (秒)
maxEmitCount = 30               # 回数指定停止時の最大発生回数 (回)
layerCount = 1

[Layer0]
layerName = BillowingSmoke
groupName = ExplosionSmoke
texturePath = assets/textures/smoke_particle.png
blendMode = Normal
emitCount = 3
maxRiseHeight = 5.5             # 上昇上限高さ (m: 短く抑えて自然な煙にする)
minLifeTime = 1.8
maxLifeTime = 2.8
minVelocityX = -0.035
minVelocityY = 0.018
minVelocityZ = -0.035
maxVelocityX = 0.035
maxVelocityY = 0.042
maxVelocityZ = 0.035
accelerationX = 0.0
accelerationY = -0.0001
accelerationZ = 0.0
randomPositionRange = 1.4
minScale = 4.5
maxScale = 7.5
endScale = 14.5
scaleEasing = 0.45
fadeOut = true
minColorR = 0.08
minColorG = 0.08
minColorB = 0.09
minColorA = 0.22
maxColorR = 0.16
maxColorG = 0.16
maxColorB = 0.18
maxColorA = 0.38
minRotation = 0.0
maxRotation = 6.283185
minRotationSpeed = -0.15
maxRotationSpeed = 0.15
isStretched = false
stretchFactor = 1.0

