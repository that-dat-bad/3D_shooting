# ========================================================
# Effect Configuration File (.effect)
# Default Fire Effect (監視塔・拠点火災ベース)
# ========================================================

[General]
name = default_fire
stopCondition = Manual          # Manual / ByDuration / ByCount
emitInterval = 0.12             # 発生間隔 (秒)
maxDuration = 5.0               # 時間指定停止時の最大継続時間 (秒)
maxEmitCount = 30               # 回数指定停止時の最大発生回数 (回)
layerCount = 1

[Layer0]
layerName = CoreFire
groupName = ExplosionFire
texturePath = assets/textures/flame_particle.png
blendMode = Add
emitCount = 2
maxRiseHeight = 2.8             # 上昇上限高さ (m: 0.0以下で無制限)
minLifeTime = 0.45
maxLifeTime = 0.85
minVelocityX = -0.020
minVelocityY = 0.015
minVelocityZ = -0.020
maxVelocityX = 0.020
maxVelocityY = 0.035
maxVelocityZ = 0.020
accelerationX = 0.0
accelerationY = 0.0
accelerationZ = 0.0
randomPositionRange = 0.8
minScale = 4.0
maxScale = 6.5
endScale = 10.5
scaleEasing = 0.42
fadeOut = true
minColorR = 1.00
minColorG = 0.38
minColorB = 0.06
minColorA = 0.85
maxColorR = 1.00
maxColorG = 0.88
maxColorB = 0.30
maxColorA = 0.95
minRotation = 0.0
maxRotation = 6.283185
minRotationSpeed = -0.25
maxRotationSpeed = 0.25
isStretched = false
stretchFactor = 1.0

